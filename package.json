{
  "name": "any2book",
  "version": "0.3.0",
  "description": "Convert personal knowledge files to faithful EPUB3 books, with installable Agent Skills support.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/congnt235/any2book.git"
  },
  "homepage": "https://github.com/congnt235/any2book#readme",
  "bugs": {
    "url": "https://github.com/congnt235/any2book/issues"
  },
  "keywords": [
    "epub",
    "epub3",
    "agent-skills",
    "ebook",
    "pdf",
    "document-conversion"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "python/any2book_processors/**/*.py",
    "configs",
    "references",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "pyproject.toml",
    "uv.lock"
  ],
  "bin": {
    "any2book": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:python": "uv run pytest",
    "test:fixtures": "vitest run tests/fixtures.test.ts",
    "fixtures:build": "tsx src/generate-fixtures.ts",
    "epubcheck": "tsx src/quality.ts epubcheck .any2book/quality",
    "test:calibre": "tsx src/quality.ts calibre .any2book/quality",
    "quality:core": "pnpm typecheck && pnpm lint && pnpm test && uv run ruff check python && uv run mypy python && uv run pytest",
    "quality": "pnpm quality:core && pnpm fixtures:build && pnpm epubcheck && pnpm test:calibre"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.38.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.6"
  },
  "packageManager": "pnpm@11.25.0"
}
